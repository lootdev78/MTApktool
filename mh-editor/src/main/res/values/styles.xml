<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/mt_primary</item>
        <item name="colorPrimaryVariant">@color/mt_primary_variant</item>
        <item name="colorOnPrimary">@color/mt_on_primary</item>
        <item name="colorSecondary">@color/mt_secondary</item>
        <item name="colorOnSecondary">@color/mt_on_secondary</item>
        <item name="android:colorAccent">@color/mt_primary</item>
        <item name="android:windowBackground">@color/mt_background</item>
        <item name="android:colorBackground">@color/mt_background</item>
        <item name="android:textColorPrimary">@color/mt_on_surface</item>
        <item name="android:textColorSecondary">@color/mt_on_surface_variant</item>
        <item name="android:statusBarColor">@color/mt_primary_variant</item>
        <item name="android:navigationBarColor">@color/mt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="actionBarStyle">@style/AppTheme.ActionBar</item>
    </style>

    <style name="AppTheme.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/mt_primary</item>
        <item name="titleTextStyle">@style/AppTheme.ActionBar.Title</item>
    </style>
    <style name="AppTheme.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/mt_on_primary</item>
    </style>

    <style name="FullScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mt_primary</item>
        <item name="colorPrimaryVariant">@color/mt_primary_variant</item>
        <item name="colorSecondary">@color/mt_secondary</item>
        <item name="android:windowBackground">@color/mt_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mt_primary</item>
        <item name="colorPrimaryVariant">@color/mt_primary_variant</item>
        <item name="colorSecondary">@color/mt_secondary</item>
        <item name="android:windowBackground">@color/mt_background</item>
    </style>
    <style name="NoStatusBar" parent="AppTheme"><item name="android:windowFullscreen">true</item></style>
    <style name="AppTheme.DebugActivity" parent="AppTheme" />
    <style name="SelectionMenuButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/mt_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="TextMaterialStyle">
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Widget.Button.Borderless.Colored</item>
        <item name="android:textColor">@color/mt_on_surface</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:minWidth">45dp</item>
        <item name="android:minHeight">42sp</item>
    </style>
</resources>
