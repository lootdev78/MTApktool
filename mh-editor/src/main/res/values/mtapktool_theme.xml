<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MTApktoolEditorTheme.Light" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0061A4</item>
        <item name="android:colorControlHighlight">#220061A4</item>
        <item name="android:colorControlNormal">#49454F</item>
        <item name="android:windowBackground">#F6F3F7</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:colorPrimary">#303236</item>
        <item name="android:colorPrimaryDark">#000000</item>
    </style>
    <style name="MTApktoolEditorTheme.Dark" parent="@android:style/Theme.Material">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9ECAFF</item>
        <item name="android:colorControlHighlight">#339ECAFF</item>
        <item name="android:colorControlNormal">#C4C7CF</item>
        <item name="android:windowBackground">#121318</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:colorPrimary">#191C21</item>
        <item name="android:colorPrimaryDark">#000000</item>
    </style>
    <style name="MTApktoolEditorTheme" parent="MTApktoolEditorTheme.Dark" />
    <style name="MTApktoolEditorPopup.Light" parent="@android:style/ThemeOverlay.Material.Light">
        <item name="android:textColorPrimary">#1D1B20</item>
        <item name="android:textColorSecondary">#49454F</item>
        <item name="android:colorControlNormal">#49454F</item>
        <item name="android:popupMenuStyle">@style/MTApktoolEditorPopupWidget.Light</item>
    </style>
    <style name="MTApktoolEditorPopup.Dark" parent="@android:style/ThemeOverlay.Material.Dark">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E0E0E0</item>
        <item name="android:colorControlNormal">#E0E0E0</item>
        <item name="android:popupMenuStyle">@style/MTApktoolEditorPopupWidget.Dark</item>
    </style>
    <style name="MTApktoolEditorPopupWidget.Light" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">#FFFFFF</item>
    </style>
    <style name="MTApktoolEditorPopupWidget.Dark" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">#303030</item>
    </style>
</resources>
