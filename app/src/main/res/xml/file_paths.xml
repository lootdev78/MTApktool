        name="cache_files"
        path="." />

    <!-- Internal/exported helper files used by built-in tools. -->
    <files-path
        name="internal_files"
        path="." />
    <external-files-path
        name="external_app_files"
        path="." />
    <external-cache-path
        name="external_cache_files"
        path="." />
</paths>
