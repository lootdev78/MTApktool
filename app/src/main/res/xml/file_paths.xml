<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal filesystem entries. -->
    <external-path
        name="external_files"
        path="." />

    <!-- Archive/APK workspaces are materialized below cacheDir. -->
