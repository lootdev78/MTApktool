#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
JAVA_CMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"
[ -n "${JAVA_HOME:-}" ] || JAVA_CMD=java
JAVA_MAJOR=$("$JAVA_CMD" -version 2>&1 | sed -n '1s/.*version "\([0-9][0-9]*\).*/\1/p')
if [ "$JAVA_MAJOR" != "17" ]; then
  echo "MTApktool Java 17 profile requires JDK 17; detected: ${JAVA_MAJOR:-unknown}" >&2
  exit 1
fi
exec "$APP_HOME/gradlew" "$@" -Pmtapktool.javaVersion=17
